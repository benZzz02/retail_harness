{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": ["tool", "final"]
    },
    "tool_name": {
      "type": "string"
    },
    "arguments_json": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "",
        "completed",
        "needs_information",
        "denied",
        "escalated",
        "system_error"
      ]
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "tool_name",
    "arguments_json",
    "outcome",
    "message"
  ],
  "additionalProperties": false
}
